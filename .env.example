# Copy to .env and set STREAM_URL to the source stream (must include protocol, e.g. https://.../index.m3u8)
# The existing script `remote_decode.sh` uses these variables when present.
STREAM_URL=https://stream.thewave.cv/your_stream_here.m3u8
OUTDIR=/workspaces/stream/hls
PORT=8080
VBITRATE=1200k
SCALE=1280:-2
